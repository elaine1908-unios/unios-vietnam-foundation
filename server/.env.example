# Long random string used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Where the SQLite database file lives. A single file, back it up like any file.
DB_PATH=./data/profiles.db

# --- Accounts ---
# There's no self-service sign-up and no env-var bootstrap — visiting the app
# with an empty users table redirects to /setup, a one-time screen that
# creates the first account at access level Owner and refuses once any
# account exists. Every other account is created from User Management
# (Owner only) afterward.

# --- Anthropic API (grammar scanning + Vietnamese -> English translation) ---
# Get a key at https://console.anthropic.com (pay-per-use, no free tier).
# Both features degrade gracefully if this is unset: the grammar scan button
# shows an explanatory error, and English views/PDFs are unavailable.
ANTHROPIC_API_KEY=
# Optional override — defaults to Haiku 4.5, which is fast/cheap and fluent
# enough in Vietnamese for grammar review and translation. A frontier model
# name works too if you want higher-quality translation at higher cost.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
