# Long random string used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Where the SQLite database file lives. A single file, back it up like any file.
DB_PATH=./data/profiles.db

# --- Microsoft Entra ID (Azure AD) single sign-on ---
# Register an app at https://portal.azure.com -> Microsoft Entra ID -> App registrations -> New registration.
#   - Redirect URI (Web platform): {APP_BASE_URL}/api/auth/callback  (e.g. http://localhost:4000/api/auth/callback in dev)
#   - After creating it: copy the Application (client) ID and Directory (tenant) ID from the Overview page.
#   - Under "Certificates & secrets", create a new client secret and copy its VALUE (not the ID).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# The externally-reachable base URL of this app (no trailing slash). Must match the Redirect URI above.
APP_BASE_URL=http://localhost:4000

# Set to "true" only for local development without a working Azure AD app registration.
# Adds POST /api/auth/dev-login, which signs in as any {name, email} with no password check.
# Never set this in production.
DEV_LOGIN=false

# --- Anthropic API (grammar scanning + Vietnamese -> English translation) ---
# Get a key at https://console.anthropic.com (pay-per-use, no free tier).
# Both features degrade gracefully if this is unset: the grammar scan button
# shows an explanatory error, and English views/PDFs are unavailable.
ANTHROPIC_API_KEY=
# Optional override — defaults to Haiku 4.5, which is fast/cheap and fluent
# enough in Vietnamese for grammar review and translation. A frontier model
# name works too if you want higher-quality translation at higher cost.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
